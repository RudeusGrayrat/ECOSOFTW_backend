# Consultas RUC/DNI de Decolecta. El token se configura solo en el servidor, nunca en el frontend.
# Estas son las rutas oficiales. Se agrega automáticamente ?numero=DOCUMENTO.
API_REST_SUNAT=https://api.decolecta.com/v1/sunat/ruc
API_REST_RENIEC=https://api.decolecta.com/v1/reniec/dni
API_REST_SUNAT_TOKEN=
# Opcional: si RENIEC usa un token distinto. Si se omite se reutiliza el anterior.
API_REST_RENIEC_TOKEN=
API_REST_SUNAT_TOKEN_HEADER=Authorization
API_REST_SUNAT_TOKEN_PREFIX=Bearer

# Opcional: ruta absoluta para los TDR/IGA adjuntados desde el formulario público.
# SOLICITUDES_STORAGE_PATH=/ruta/segura/storage/solicitudes-cotizacion
